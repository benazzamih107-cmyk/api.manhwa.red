{"id":"943bff3ef1","t":"Ovcharka","c":"mg:/uploads/series/69b620d730782886d71186db-c48df0d8b2b1f85a.webp","n":42,"l":42,"s":["mg","ml","az"],"k":{"mg":"ovcharka","ml":"ovcharka","az":"ovcharka"},"u":1795078054029,"desc":"«أوفشاركا» (Ovcharka / 오브차카) مانهوا قتال وجريمة قاسية وعنيفة من إنتاج فرق العمل التابعة لشركة بارك تاي جون، تقدم وجبة أكشن مشبعة بالقتالات الملحمية وحرب العصابات الروسية والكورية. تدور القصة حول مقاتل متوحش وعنيد يُلقب بـ «أوفشاركا» نسبة إلى سلالة كلاب الرعي القوقازية العملاقة الشرسة، والذي نشأ في بيئة سجون باردة وعاش حياة ملطخة بالدماء لا ترحم الضعفاء. يجد بطلنا نفسه وسط صراع دموي طاحن بين مافيات المنظمات المنظمة ورجال الأعمال الفاسدين الذين يحاولون السيطرة على الأحياء الفقيرة والموانئ الحيوية. معتمدًا على بنيته الجسدية الهائلة، وغريزته القتالية المتوحشة، وقدرته الخارقة على تحمل الألم وسحق الخصوم بضربات حاسمة لا تعرف الرحمة، يشق أوفشاركا طريقه في مواجهة جحافل البلطجية ومحترفي الفنون القتالية المختلطة. العمل من كتابة Byeongjang و Park Man-sa مع رسوم ديناميكية متفجرة للفنان Haetae، وبدأ نشره على Naver Webtoon سنة 2024 ليحقق صدى واسعًا بين عشاق قتالات الشوارع الدموية والأجواء الواقعية الصادمة. تابع فصول «Ovcharka» مترجمة بالكامل بأعلى جودة عبر منصة مانجا تايم (MangaTime).","type":"مانهوا","status":"مستمر","genres":["أكشن"],"src":{"mg":"ovcharka","ml":"ovcharka","az":"ovcharka"},"chapters":{"1":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/1/","az":"ovcharka|/series/ovcharka/chapter-1"},"2":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/2/"},"3":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/3/"},"4":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/4/"},"5":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/5/"},"6":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/6/"},"7":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/7/"},"8":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/8/"},"9":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/9/"},"10":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovcharka/10/"},"11":{"mg":"ovcharka|","ml":"ovcharka|/manga/ovch