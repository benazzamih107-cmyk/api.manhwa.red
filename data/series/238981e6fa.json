{"id":"238981e6fa","t":"Tengoku Daimakyou","c":"cv","n":90,"l":87,"s":["mg","ml","aq","aq"],"k":{"mg":"tengoku-daimakyou","ml":"tengoku-daimakyou","aq":"tengoku-daimakyou"},"u":1795852053579,"desc":"تسير مانجا Tengoku Daimakyou (الوهم السماوي / Heavenly Delusion) في مسارين متوازيين: أطفال يعيشون داخل منشأة محصنة تشبه الحديقة المثالية دون معرفة العالم الخارجي، ومارو مع حارسته كيروكو اللذين يجوبان أنقاض اليابان بحثاً عن المكان المسمى السماء. في عالم مدمر تسكنه مخلوقات خطيرة وبشر يحاولون البقاء، تتشابك الألغاز تدريجياً لتكشف الصلة العميقة بين داخل المنشأة وخارجها في حبكة خيال علمي متماسكة. العمل من تأليف ورسم ماساكازو إيشيغورو (Masakazu Ishiguro)، ويحظى بإشادة واسعة لعمقه الدرامي والغموض المتقن. تابع الفصول مترجمة للعربية عبر مانجا تايم (MangaTime).","type":"مانجا","status":"مستمر","genres":["خيال علمي","دراما","رعب","نفسي","غموض","خارق للطبيعة","كوميديا"],"src":{"mg":"tengoku-daimakyou","ml":"tengoku-daimakyou","aq":"tengoku-daimakyou"},"chapters":{"1":{"mg":"tengoku-daimakyou|","ml":"tengoku-daimakyou|/manga/tengoku-daimakyou/1/","aq":"tengoku-daimakyou|/manga/tengoku-daimakyou/1/"},"2":{"mg":"tengoku-daimakyou|","ml":"tengoku-daimakyou|/manga/tengoku-daimakyou/2/","aq":"tengoku-daimakyou|/manga/tengoku-daimakyou/2/"},"3":{"mg":"tengoku-daimakyou|","ml":"tengoku-daimakyou|/manga/tengoku-daimakyou/3/","aq":"tengoku-daimakyou|/manga/tengoku-daimakyou/3/"},"4":{"mg":"tengoku-daimakyou|","ml":"tengoku-daimakyou|/manga/tengoku-daimakyou/4/","aq":"tengoku-daimakyou|/manga/tengoku-daimakyou/4/"},"5":{"mg":"tengoku-daimakyou|","ml":"tengoku-daimakyou|/manga/tengoku-daimakyou/5/","aq":"tengoku-daimakyou|/manga/tengoku-daimakyou/5/"},"6":{"mg":"tengoku-daimakyou|","ml":"tengoku-daimakyou|/manga/tengoku-daimakyou/6/","aq":"tengoku-daimakyou|/manga/tengoku-daimakyou/6/"},"7":{"mg":"tengoku-daimakyou|","ml":"tengoku-daimakyou|/manga/tengoku-daimakyou/7/","aq":"tengoku-daimakyou|/manga/tengoku-daimakyou/7/"},"8":{"mg":"tengoku-daimakyou|","ml":"tengoku-daimakyou|/manga/tengoku-dai